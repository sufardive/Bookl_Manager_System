<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 覆盖用户级 NuGet.Config 中已失效的本地源（D:\project\DWS\YiwuSto\local-nuget，目录已不存在）。
         本项目只依赖 nuget.org 的公开包，因此清空继承的源后只保留 nuget.org，避免 NU1301。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
